# Copy to .env.local (git-ignored) to override the dev API target.
# .env.local takes precedence over .env.development, which is what `vite dev`
# loads (development mode — .env.production is only read by `vite build`).
#
# You probably do not need this file. .env.development already points at the
# local nutshell-mvp nginx on :9004, which is what you want: nginx strips the
# /api prefix and answers the CORS preflight for this origin.
#
# DO NOT point this at the backend port (:5004) directly. That bypasses both.
# The backend has no CORS middleware and its routes carry no /api prefix, so the
# form dies on the preflight — and it dies invisibly, because a failed preflight
# never reaches the server and so never appears in any log. That is exactly how
# mbz-0v2l went unnoticed for a month, and mbz-r53x before it.
#
# The value below is the same nginx origin .env.development uses; change the
# port only if you are running nginx somewhere else.
VITE_API_BASE_URL=http://localhost:9004

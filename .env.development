# Loaded by Vite during `vite dev` (development mode).
# Points at the local nutshell-mvp nginx (not the backend directly) so the dev
# request path mirrors prod: nginx rewrites /api/* to bare paths before
# proxying to the backend. Hitting the backend directly bypasses that strip
# and masks 404s like the one in mbz-r53x. Override in .env.local if needed.
VITE_API_BASE_URL=http://localhost:9004
